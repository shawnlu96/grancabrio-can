# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
ap_password: "fallback-hotspot-password"   # at least 8 characters
# 32 random bytes, base64. Generate with:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "choose-an-ota-password"
